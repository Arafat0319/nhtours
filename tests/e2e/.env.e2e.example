# Copy to .env.e2e and adjust. Never commit real secrets.
E2E_BASE_URL=http://127.0.0.1:8080
E2E_TRIP_SLUG=qa-payment-trip-2026
# Optional: Stripe Test secret for Booking / Admin / detail paid paths
# E2E_STRIPE_SECRET_KEY=sk_test_...
# Optional: same whsec_ as flask-app for webhook idempotency detail
# E2E_STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: admin/staff for Admin module
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
# E2E_STAFF_USERNAME=_pytest_staff
# E2E_STAFF_PASSWORD=pytest-staff-temp
# Optional: discount code (default QAZERO)
# E2E_DISCOUNT_CODE=QAZERO
# Optional: unpublished slug to assert 404 for guests
# E2E_UNPUBLISHED_SLUG=
